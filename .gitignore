# Per-task editable checkouts made for the Claude Code arms — one full repo copy
# PER TASK PER ARM (gigabytes). Never committable; `git add -A` would otherwise
# try to stage every cloned repository in the benchmark.
eval/datasets/_claude_repos/
eval/datasets/*.jsonl
# ...except the frozen task sets the published study ran on (SWE-bench Verified is
# MIT-licensed, SWE-rebench CC-BY-4.0; see eval/datasets/README.md). Everything
# else in eval/datasets/ is a working copy or an abandoned subset.
!eval/datasets/swebench_100.jsonl
!eval/datasets/graphify_100.jsonl
!eval/datasets/swebench_100_prose_stripped.jsonl
!eval/datasets/swe_rebench_100.jsonl
!eval/datasets/swe_rebench_100_prose.jsonl
eval/results/
eval/figures/
eval/logs/

