{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.yashdoke7/skeletongraph",
  "description": "Zero-LLM structural code retrieval for AI coding agents, served over MCP.",
  "version": "0.1.1",
  "repository": {
    "url": "https://github.com/yashdoke7/skeletongraph",
    "source": "github"
  },
  "websiteUrl": "https://github.com/yashdoke7/skeletongraph",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "skeletongraph",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "serve",
          "value": "serve",
          "description": "Start the SkeletonGraph MCP server (stdio transport)."
        },
        {
          "type": "named",
          "name": "--path",
          "isRequired": true,
          "format": "filepath",
          "description": "Path to the project repository SkeletonGraph should index and serve.",
          "placeholder": "/path/to/your/project"
        }
      ]
    }
  ]
}
